<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="http://localhost:3000/css/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> <%= title %> </title>
</head>
<body>
    <div>
    
        <form action="/user/<%= user.id %>?method=PUT" method="post" >
            <input type="text" , placeholder="id" , value="<%= user.id %>" , name="id">
            <input type="text" , placeholder="name"  , value="<%= user.name %>" , name="name">
            <input type="text" , placeholder="password"  , value="<%= user.password %>" , name="password">
            <input type="text" , placeholder="email"  , value="<%= user.email %>" , name="email">
            <input type="submit" , value="update">
        </form>

    </div>

</body>
</html>